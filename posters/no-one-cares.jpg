/* <![CDATA[ */
{"@context":"https://schema.org","@type":"Movie","dateCreated":"2024-11-21T17:47:10Z","dateModified":"2026-05-14T04:56:03Z","description":"A shy woman is unexpectedly cast in a local production of an original musical. Under the spell of the strong-willed and enigmatic director, she loses herself in the role and the high-stakes world of this community theater production.","isFamilyFriendly":true,"name":"No One Cares","url":"https://www.themoviedb.org/movie/1391239-no-one-cares","countryOfOrigin":[{"@type":"Country","name":"United States"}],"genre":["Music","Comedy"],"image":"https://image.tmdb.org/t/p/w500/iOJmcUonmHuWlDAqyno9Kz3rCeG.jpg"}
